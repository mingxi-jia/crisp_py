{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    


        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: pcd example",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/examples/pcd_example.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: pcd diffusion policy eval",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/eval/pcd_diff_eval.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
            "--mode", "simple",
            "--n-steps", "60",
            "--direct-policy",
            "--ckpt-path", "/home/mingxi/Downloads/epoch=0060-val_loss=0.021 (1).ckpt"
            ]
        }
    ]
}